<!DOCTYPE html>
<html lang="en">
 <head>
 <meta charset="utf-8" />
  <title> Khadeejah - my corner of the internet</title>
 <link rel="stylesheet" href="style.css" />
   </head>
   <body>
    <header class="hero">
        <h1>Hi, I'm Khadeejah</h1>
         <p class="tagline">
          and this page is about ... 
     <strong>My PERFECT day!</strong>
     </p>
          </header>

          <main>
            <Section class="card">
                <h2>What's better than sleeping in?...Breakfast!</h2>
             <button onclick="randomOption()">Click me for a delectable breakfast!</button>

     <p id="result">Cooking...</p>

      <img id="breakfastImage" src="" alt="Random breakfast">
    
    </section>

    <section class="card">
  <h2>While eating... Books!</h2>
<button onclick="randomActivity()">Click me for a mesmerising Book!</button>
<p id="bookresult">Writing...</p>

</section>

<section class="card">
  <h2>Bored?</h2>
<button onclick="randomThing()">Click me for fun activity!</button>
<p id="activityresult">Thinking...</p>

</section>

     <section class="card">
        <button id="cheer">cheer me on!</button>
        <p id="count">0 cheers</p>
    </section>
          </main>
<script src="script.js"></script>
          <footer>
  <p>Made by Khadeejah Sofiullah</p>
</footer>
</body>
</html>
